; tb_sm_no_smx_instr.sv test_jmp_conditions: check_jmp "jmp x--, x = 1".
; A taken jump stops at slot 10, a fall-through at slot 4.
.program test_jmp_conditions_3

    set x, 1            ; 0
    nop                 ; 1
    nop                 ; 2
    jmp x--, taken      ; 3
fall_through:
    jmp fall_through    ; 4
    nop                 ; 5-9: unused
    nop
    nop
    nop
    nop
taken:
    jmp taken           ; 10
