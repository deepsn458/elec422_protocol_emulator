; tb_sm_no_smx_instr.sv test_set_and_wrap: squarewave_fast, wrap 2 -> 1.
.program test_set_and_wrap
.set_execctrl 0x00002080        ; wrap 2 -> 1 (also set by .wrap_target/.wrap)
.set_pinctrl  0x04000060        ; SET_COUNT 1, SET_BASE 3

    set pindirs, 1
.wrap_target
    set pins, 1
    set pins, 0
.wrap
