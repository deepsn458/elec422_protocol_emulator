; tb_sm_no_smx_instr.sv test_clock_divider_and_enable: squarewave, divide by 3.
.program test_clock_divider_and_enable_0
.set_clkdiv   0x00030000        ; divide by 3
.set_execctrl 0x00002080        ; wrap 2 -> 1
.set_pinctrl  0x04000080        ; SET_COUNT 1, SET_BASE 4 (bidirectional)

    set pindirs, 1
.wrap_target
    set pins, 1
    set pins, 0
.wrap
