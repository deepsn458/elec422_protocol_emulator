; tb_sm_no_smx_instr.sv test_jmp_conditions: check_jmp "jmp !osre, 8 of 8 bits out".
; A taken jump stops at slot 10, a fall-through at slot 4.
.program test_jmp_conditions_16
.set_shiftctrl 0x100C0000       ; PULL_THRESH 8

    pull block          ; 0
    out null, 8         ; 1
    nop                 ; 2
    jmp !osre, taken    ; 3
fall_through:
    jmp fall_through    ; 4
    nop                 ; 5-9: unused
    nop
    nop
    nop
    nop
taken:
    jmp taken           ; 10
