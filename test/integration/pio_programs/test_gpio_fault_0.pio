; tb_imem_to_gpio.sv test_gpio_fault 0: a completed instruction with a delay
; drives an input-only GPIO. The GPIO controller raises a drive fault.
.program test_gpio_fault_0
.set_execctrl 0x00A1F000        ; FAULT_VEC 20
.set_pinctrl  0x04100080        ; OUT_COUNT 1, OUT_BASE 0; SET_COUNT 1, SET_BASE 4

    set pindirs, 1      ; 0: GPIO 4 (bidirectional) to output
loop:
    set pins, 1         ; 1: GPIO 4 high
    out pins, 1 [3]     ; 2: GPIO 0 is input only: drive fault
    jmp loop            ; 3
    nop                 ; 4-19: unused
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
fault:
    set pins, 0         ; 20: FAULT_VEC; legal, but ignored while faulted
handler:
    jmp handler         ; 21
