; tb_sm_no_smx_instr.sv test_gpio_fault a: fault on a completed instruction.
.program test_gpio_fault_0
.set_execctrl 0x00A1F000        ; FAULT_VEC 20
.set_pinctrl  0x04000060        ; SET_COUNT 1, SET_BASE 3

    set pindirs, 1      ; 0
loop:
    set pins, 1 [3]     ; 1
    jmp loop            ; 2
    nop                 ; 3-19: unused
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
fault:
    set pins, 0         ; 20: FAULT_VEC
handler:
    jmp handler         ; 21
