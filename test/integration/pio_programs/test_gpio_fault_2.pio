; tb_imem_to_gpio.sv test_gpio_fault 2: IRQ WAIT whose side-set drives an
; input-only GPIO faults on its first cycle; the IRQ WAIT is abandoned.
; Expected to fail: the assembler emits NOP for IRQ while it is reserved.
.program test_gpio_fault_2
.set_execctrl 0x40A1F000        ; SIDE_EN, FAULT_VEC 20
.set_pinctrl  0x40000000        ; 2 side-set bits incl. enable, GPIO 0
.side_set 1 opt

    irq wait 0 side 1   ; 0: side-set on GPIO 0 (input only): drive fault
    nop                 ; 1-19: unused
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
fault:
    jmp fault           ; 20: FAULT_VEC
