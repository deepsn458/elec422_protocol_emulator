; tb_sm_no_smx_instr.sv test_jmp_conditions: check_jmp "jmp x!=y, equal".
; A taken jump stops at slot 10, a fall-through at slot 4.
.program test_jmp_conditions_9

    set x, 3            ; 0
    set y, 3            ; 1
    nop                 ; 2
    jmp x!=y, taken     ; 3
fall_through:
    jmp fall_through    ; 4
    nop                 ; 5-9: unused
    nop
    nop
    nop
    nop
taken:
    jmp taken           ; 10
