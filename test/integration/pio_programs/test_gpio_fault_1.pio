; tb_imem_to_gpio.sv test_gpio_fault 1: WAIT on an output-only GPIO. No fault
; during the previous instruction's delay; a read fault once the WAIT runs.
.program test_gpio_fault_1
.set_execctrl 0x00A1F000        ; FAULT_VEC 20

    set x, 1 [5]        ; 0
    wait 1 gpio 13      ; 1: GPIO 13 is output only: read fault
    nop                 ; 2-19: unused
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    nop
fault:
    jmp fault           ; 20: FAULT_VEC
